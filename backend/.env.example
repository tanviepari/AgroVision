PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/agrovision
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Optional. Password reset emails are sent only when all SMTP values are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgroVision <noreply@example.com>

# Optional. Production image hosting. Without these, local development stores files in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Crop disease detection service. If empty, scans return a clear unavailable message.
DISEASE_API_URL=
DISEASE_API_KEY=

# Optional. Live weather. If empty, the dashboard says weather is unavailable.
OPENWEATHER_API_KEY=
